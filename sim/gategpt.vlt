`verilator_config
// Lint waiver file for gateGPT (Verilator only; not part of the ISE project).
//
// Every rule below is waived on purpose: the warnings are intentional design
// choices, not defects. The RTL is bit-exact against the Python reference
// (verified by sim/tb_*.v) and synthesizes on ISE 14.7. This file changes NO
// behaviour -- it only silences reviewed, benign lint categories so that
// `verilator --lint-only -Wall` reports clean.

// Fixed-point datapath deliberately accumulates/multiplies in wider
// intermediates and then truncates + saturates explicitly (Q5.11).
lint_off -rule WIDTHEXPAND
lint_off -rule WIDTHTRUNC

// Unused upper bits / sized parameters (e.g. spare DCM outputs, LANES_W).
lint_off -rule UNUSEDSIGNAL
lint_off -rule UNUSEDPARAM

// Intentionally-unconnected pins: spare DCM clock outputs and udiv.rem_out
// where the remainder is not consumed.
lint_off -rule PINCONNECTEMPTY
lint_off -rule PINMISSING

// Blocking '=' inside functions (required by Verilog) and the LCD FSM's
// same-cycle scratch register.
lint_off -rule BLKSEQ

// rst_btn feeds the DCM's asynchronous reset and is also debounced
// synchronously in the top -- correct on real hardware.
lint_off -rule SYNCASYNCNET

// Generated ROM function argument names (sel) shadow the wrapping module port.
lint_off -rule VARHIDDEN

// Mixed timescale: the synthesis RTL declares none; the sim stubs/testbenches
// set 1ns/1ps.
lint_off -rule TIMESCALEMOD

// Simulation-only stub file (xilinx_stubs.v) holds several vendor-cell models,
// so module names do not match the filename.
lint_off -rule DECLFILENAME

// LCD setup/settle waits are parameterized on CLK_HZ; at a small (simulation)
// CLK_HZ a threshold like SU_CYC-1 becomes 0, so `cnt >= 0` is constant-true.
// That is the intended "minimum wait" behaviour, not a bug.
lint_off -rule UNSIGNED -file "*lcd_hd44780.v"
